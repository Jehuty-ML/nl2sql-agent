# ClickHouse（与 infra/docker-compose.yml 对齐）
# Agent 必须用只读账号；管理账号 lumen/lumen_demo 仅给造数脚本
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=lumen_ro
CH_PASSWORD=lumen_ro_demo
CH_DATABASE=lumenlearn


# 激活哪家：dashscope | deepseek | ark（豆包） | ollama | openai
LLM_PROVIDER=dashscope
LLM_TIMEOUT=180
# 是否打开 reasoning/thinking（默认 true；超时或 4xx 会自动降级重试一次）
LLM_ENABLE_REASONING=true
# 同一步并行工具上限（只读查数可并行；export_report 仍串行屏障）。设为 1 则强制串行
MAX_PARALLEL_TOOL_CALLS=4

# 可选总覆盖（非空则优先于下面各 Provider 专用项）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 阿里云 DashScope / 通义（默认）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 火山方舟 Ark / 豆包（OpenAI 兼容）
# 注意：ARK_MODEL 一般填推理接入点 ID（ep-xxxxxxxx），不是 doubao 产品名
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-xxxxxxxx

# 本地 Ollama（可不填真实 Key）
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# 通用 OpenAI（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Phase 1 投影
MODEL_ROW_CAP=50
MODEL_SAMPLE_ROWS=5
MODEL_JSON_CHAR_CAP=8192

# Phase 5 SQL 形态
REJECT_DETAIL_SQL=false
DETAIL_SAMPLE_ONLY=true

# Phase 6
ENABLE_PLAN_MODE=false

# Phase 7 软数字对账
ENABLE_NUMERIC_AUDIT=false

# Phase 8
SPILL_THRESHOLD_BYTES=262144
QUERY_TIMEOUT_SECONDS=60

# 自进化一期（默认关闭；改为 true 打开记忆/信号收获/skill 提案，不改模型权重）
# 详见 docs/self-evolution.md
ENABLE_EVOLUTION=false
ACTIVE_STRATEGY_ID=v1_baseline
# 同一 SQL 指纹成功次数达到阈值后生成 pending 提案
EVOLUTION_PATTERN_THRESHOLD=3
EVOLUTION_MEMORY_CHAR_CAP=1200

# 未配置对应 API Key 时：自动走关键词固定分析（不报错）

APP_NAME=lumen-query-agent-http
APP_PORT=6010
